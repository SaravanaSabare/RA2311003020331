# Affordmed Evaluation Service Credentials
# Fill these in with your actual credentials after registration

CLIENT_EMAIL=your_email@college.edu
CLIENT_NAME=Your Name
ROLL_NO=your_roll_number
ACCESS_CODE=your_access_code
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret

# This token is auto-managed by the logging middleware via getAuthToken()
# You can leave ACCESS_TOKEN blank; the backend will use clientID/clientSecret to fetch it.
# OR paste a fresh token here for quick testing:
ACCESS_TOKEN=
